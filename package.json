{
  "name": "idwall-playwright",
  "version": "1.0.0",
  "description": "Framework de automação E2E utilizando Playwright para o Blog da Idwall.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
